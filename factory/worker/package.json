{
  "name": "de-school-factory-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:assets": "bash scripts/sync-claude-assets.sh",
    "typecheck": "bash scripts/sync-claude-assets.sh && tsc --noEmit",
    "test": "vitest run",
    "dev": "bash scripts/sync-claude-assets.sh && wrangler dev --local --port 8787",
    "migrate:local": "wrangler d1 migrations apply factory --local",
    "smoke": "bash scripts/smoke.sh",
    "deploy": "bash scripts/sync-claude-assets.sh && bash scripts/check-no-fake.sh && wrangler deploy"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@cloudflare/workers-types": "^5.20261102.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.156.2"
  }
}
